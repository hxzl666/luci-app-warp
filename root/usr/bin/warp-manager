#!/bin/sh
# Cloudflare WARP 核心管理脚本，使用 sing-box 承载 wireguard 出站
# SPDX-License-Identifier: GPL-3.0-or-later

. /lib/functions.sh

DATA_DIR="/etc/warp"
REG_FILE="$DATA_DIR/reg.json"
SINGBOX_CONF="$DATA_DIR/sing-box.json"

# 查找系统可用的 sing-box 二进制文件
find_singbox() {
	if command -v sing-box >/dev/null 2>&1; then
		command -v sing-box
		return 0
	fi
	for path in "/usr/bin/sing-box" "/usr/sbin/sing-box" "/usr/local/bin/sing-box" "/usr/share/singbox/sing-box"; do
		if [ -x "$path" ]; then
			echo "$path"
			return 0
		fi
	done
	return 1
}

# 检查依赖
need_singbox() {
	if ! find_singbox >/dev/null; then
		printf 'Error: sing-box binary not found. Please install it first.\n' >&2
		return 1
	fi
}

# 注册 WARP 账户，获取私钥、IPv6 及 reserved 配置
register_account() {
	printf 'Registering new WARP account via warp.xijp.eu.org...\n'
	mkdir -p "$DATA_DIR"
	
	# 使用临时文件保存接口响应
	tmp_file="/tmp/warp_res.$$"
	if command -v curl >/dev/null 2>&1; then
		curl -ks --connect-timeout 10 --max-time 15 "https://warp.xijp.eu.org" > "$tmp_file"
	elif command -v wget >/dev/null 2>&1; then
		wget --no-check-certificate -qO- --timeout=10 "https://warp.xijp.eu.org" > "$tmp_file"
	fi
	
	if [ ! -s "$tmp_file" ]; then
		printf 'Error: Failed to fetch configuration from warp.xijp.eu.org.\n' >&2
		rm -f "$tmp_file"
		return 1
	fi
	
	# 从中文响应中提取私钥、IPv6及reserved参数
	private_key=$(grep -i "私钥" "$tmp_file" | head -n1 | sed -E 's/.*私钥[：:]//' | tr -d '\r\n ')
	[ -z "$private_key" ] && private_key=$(grep -i "private_key" "$tmp_file" | head -n1 | sed -E 's/.*(key|私钥)[：:]//' | tr -d '\r\n ')
	# 强行滤除任何 UTF-8 BOM 或控制台着色字符等杂质
	private_key=$(echo "$private_key" | tr -cd 'a-zA-Z0-9+/=')
	
	ipv6_addr=$(grep -i "IPV6" "$tmp_file" | head -n1 | sed -E 's/.*地址[：:]//' | tr -d '\r\n ')
	[ -z "$ipv6_addr" ] && ipv6_addr=$(grep -i "ipv6" "$tmp_file" | head -n1 | sed -E 's/.*(address|地址)[：:]//' | tr -d '\r\n ')
	# 强行滤除 IPv6 地址中的非打印字符和乱码字符
	ipv6_addr=$(echo "$ipv6_addr" | tr -cd '0-9a-fA-F:')
	
	reserved_val=$(grep -i "reserved" "$tmp_file" | head -n1 | sed -E 's/.*值[：:]//' | tr -d '\r\n ')
	[ -z "$reserved_val" ] && reserved_val=$(grep -i "reserved" "$tmp_file" | head -n1 | sed -E 's/.*(val|值)[：:]//' | tr -d '\r\n ')
	# 强行滤除 reserved 数组字符中的乱码
	reserved_val=$(echo "$reserved_val" | tr -cd '0-9,[]')
	
	rm -f "$tmp_file"
	
	if [ -z "$private_key" ] || [ -z "$ipv6_addr" ] || [ -z "$reserved_val" ]; then
		printf 'Error: Failed to parse WARP credentials from response.\n' >&2
		return 1
	fi
	
	# 保存至 UCI 配置中
	uci -q set warp.config.address_v4="172.16.0.2"
	uci -q set warp.config.address_v6="$ipv6_addr"
	uci -q set warp.config.private_key="$private_key"
	uci -q set warp.config.reserved="$reserved_val"
	uci commit warp
	
	# 生成备份及状态标识文件 reg.json
	cat > "$REG_FILE" <<EOF
{
  "private_key": "$private_key",
  "ipv6_addr": "$ipv6_addr",
  "reserved": $reserved_val
}
EOF
	
	printf 'Successfully registered WARP account and saved credentials.\n'
	return 0
}

# 升级授权（在使用 sing-box 承载时由于依赖外部 API，本地无法直接触发 update 逻辑，此处仅记录 UCI 并提示）
apply_license() {
	LICENSE_KEY="${1:-$(uci -q get warp.config.license_key)}"
	if [ -z "$LICENSE_KEY" ]; then
		printf 'Error: license_key is empty in configuration.\n' >&2
		return 1
	fi

	uci -q set warp.config.license_key="$LICENSE_KEY"
	uci commit warp
	printf 'License key saved. (Note: key upgrade is handled externally by warp.xijp.eu.org)\n'
	return 0
}

# 获取当前服务运行状态
get_status() {
	if pgrep -f "sing-box.*warp/sing-box.json" >/dev/null 2>&1; then
		printf 'Service: running\n'
		
		# 检查本地 SOCKS5 与 HTTP 端口是否正常监听
		socks_port="$(uci -q get warp.config.socks_port)"
		http_port="$(uci -q get warp.config.http_port)"
		
		[ -n "$socks_port" ] && netstat -tln 2>/dev/null | grep -q ":${socks_port} " && \
			printf 'SOCKS5 Proxy: listening on port %s\n' "$socks_port"
			
		[ -n "$http_port" ] && netstat -tln 2>/dev/null | grep -q ":${http_port} " && \
			printf 'HTTP Proxy: listening on port %s\n' "$http_port"
			
	else
		printf 'Service: stopped\n'
	fi

	if [ -f "$REG_FILE" ]; then
		printf 'Account: registered\n'
		addr_v4="$(uci -q get warp.config.address_v4)"
		addr_v6="$(uci -q get warp.config.address_v6)"
		[ -n "$addr_v4" ] && printf 'IPv4: %s\n' "$addr_v4"
		[ -n "$addr_v6" ] && printf 'IPv6: %s\n' "$addr_v6"
	else
		printf 'Account: not registered\n'
	fi
}

# 测试网络连接（使用本地 SOCKS5 代理请求 Cloudflare 状态接口）
test_connection() {
	socks_port="$(uci -q get warp.config.socks_port)"
	
	if [ -z "$socks_port" ]; then
		printf 'Error: socks_port is not configured.\n' >&2
		return 1
	fi
	
	if ! netstat -tln 2>/dev/null | grep -q ":${socks_port} "; then
		printf 'Error: SOCKS5 proxy is not running on port %s.\n' "$socks_port" >&2
		return 1
	fi

	printf 'Testing connection through WARP SOCKS5 proxy...\n'
	
	test_output="$(curl -ks -x "socks5://127.0.0.1:$socks_port" --max-time 10 https://www.cloudflare.com/cdn-cgi/trace)"
	
	if [ -z "$test_output" ]; then
		printf 'Failed to connect to Cloudflare trace service.\n' >&2
		return 1
	fi

	warp_status="$(echo "$test_output" | grep -i "^warp=" | cut -d= -f2)"
	ip_address="$(echo "$test_output" | grep -i "^ip=" | cut -d= -f2)"
	location="$(echo "$test_output" | grep -i "^loc=" | cut -d= -f2)"

	printf '\n--- Test Results ---\n'
	if [ "$warp_status" = "on" ] || [ "$warp_status" = "plus" ]; then
		printf 'WARP Status: \033[32m%s\033[0m\n' "$warp_status"
	else
		printf 'WARP Status: \033[31m%s\033[0m\n' "${warp_status:-unknown}"
	fi
	printf 'Exit IP: %s\n' "${ip_address:-unknown}"
	printf 'Location: %s\n' "${location:-unknown}"
	printf '--------------------\n'
}

# 重置并清除配置
reset_account() {
	printf 'Resetting WARP account data...\n'
	rm -f "$REG_FILE" "$SINGBOX_CONF"
	uci -q delete warp.config.address_v4
	uci -q delete warp.config.address_v6
	uci -q delete warp.config.private_key
	uci -q delete warp.config.reserved
	uci commit warp
	printf 'Account data has been cleared.\n'
}

# 导出生成的配置文件
export_config() {
	if [ -f "$SINGBOX_CONF" ]; then
		cat "$SINGBOX_CONF"
	else
		printf 'No configuration found. Generate it first.\n' >&2
		return 1
	fi
}

set_enabled() {
	value="$1"
	uci -q get warp.config >/dev/null 2>&1 || uci set warp.config='warp'
	uci set warp.config.enabled="$value"
	uci commit warp
}

case "${1:-}" in
	register)
		register_account
		;;
	license)
		apply_license "${2:-}"
		;;
	status)
		get_status
		;;
	test)
		test_connection
		;;
	start)
		set_enabled 1
		/etc/init.d/warp start
		;;
	stop)
		set_enabled 0
		/etc/init.d/warp stop
		;;
	restart)
		set_enabled 1
		/etc/init.d/warp restart
		;;
	reset)
		reset_account
		;;
	export)
		export_config
		;;
	*)
		printf 'Usage: %s {register|license <key>|start|stop|restart|status|test|reset|export}\n' "$0"
		exit 1
		;;
esac
