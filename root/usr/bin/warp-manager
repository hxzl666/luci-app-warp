#!/bin/sh
# Cloudflare WARP 核心管理脚本，使用 usque (MASQUE 协议) 承载 WARP 出站
# SPDX-License-Identifier: GPL-3.0-or-later

. /lib/functions.sh

DATA_DIR="/etc/warp"
USQUE_CONF="$DATA_DIR/config.json"
USQUE_BIN="${USQUE_BIN:-/usr/bin/usque}"
USQUE_VERSION="v4.2.1"
USQUE_VER_NUM="4.2.1"
USQUE_BASE_URL="https://github.com/Diniboy1123/usque/releases/download/${USQUE_VERSION}"

# ── 颜色输出 ──────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

msg_ok()   { printf '%b\n' "${GREEN}OK:${NC} $*"; }
msg_warn() { printf '%b\n' "${YELLOW}WARN:${NC} $*"; }
msg_err()  { printf '%b\n' "${RED}ERROR:${NC} $*" >&2; }

# ── 查找 usque 二进制文件 ───────────────────────────────────────────────
find_usque() {
	if command -v usque >/dev/null 2>&1; then
		command -v usque
		return 0
	fi
	for path in "$USQUE_BIN" "/usr/bin/usque" "/usr/local/bin/usque"; do
		if [ -x "$path" ]; then
			echo "$path"
			return 0
		fi
	done
	return 1
}

need_usque() {
	if ! find_usque >/dev/null 2>&1; then
		msg_err "usque binary not found. Run '$0 install-usque' first."
		return 1
	fi
}

# ── JSON 解析辅助 (优先 jsonfilter，回退 jq) ───────────────────────────
# jsonfilter 使用 -e '@.key' 语法,jq 使用 '.key' 语法,两者不兼容
# 这里用通用方式:先尝试 jsonfilter,失败则回退 jq
json_get() {
	local key="$1"
	local file="$2"
	local result
	# jsonfilter 语法:@.key
	if command -v jsonfilter >/dev/null 2>&1; then
		result="$(jsonfilter -s "$file" -e "@.$key" 2>/dev/null)"
		[ -n "$result" ] && echo "$result" && return 0
	fi
	# jq 回退:.key (用 // empty 避免输出 "null")
	if command -v jq >/dev/null 2>&1; then
		local jq_key
		jq_key=$(echo "$key" | sed 's/^@\.//')
		result="$(jq -r ".$jq_key // empty" "$file" 2>/dev/null)"
		[ -n "$result" ] && echo "$result" && return 0
	fi
	return 1
}

# ── 注册 WARP 账户 ─────────────────────────────────────────────────────
# 在 /etc/warp 目录下运行 usque register，生成 config.json
# 然后解析 config.json 提取 private_key / address_v4 / address_v6 保存到 UCI
register_account() {
	need_usque || return 1

	local USQUE_PATH
	USQUE_PATH="$(find_usque)"

	# 确保数据目录存在
	mkdir -p "$DATA_DIR"

	local dev_name
	dev_name="openwrt-$(uci -q get warp.config.usque_arch 2>/dev/null || echo 'device')-$$"
	# 截断设备名长度（usque/WARP API 限制）
	dev_name="$(echo "$dev_name" | head -c 20)"

	msg_ok "Registering new WARP account via usque..."
	msg_ok "Device name: $dev_name"

	# usque register 必须在 config 目录中运行
	# 注意:usque register 有时会在输出 EOF 错误后仍然成功生成 config.json
	(
		cd "$DATA_DIR" || exit 1
		"$USQUE_PATH" register -a --model PC --name "$dev_name" 2>&1 || true
	)

	# 验证 config.json 已生成 (即使 usque 输出了错误,只要文件存在就继续)
	if [ ! -f "$USQUE_CONF" ]; then
		msg_err "usque register failed and config.json was not created."
		return 1
	fi

	msg_ok "config.json created, extracting account info..."

	# 解析 config.json 提取关键字段
	# usque v4.x config.json 字段名:private_key, ipv4, ipv6, access_token
	local private_key address_v4 address_v6 license_key

	private_key="$(json_get 'private_key' "$USQUE_CONF")"
	address_v4="$(json_get 'ipv4' "$USQUE_CONF")"
	address_v6="$(json_get 'ipv6' "$USQUE_CONF")"
	license_key="$(json_get 'license_key' "$USQUE_CONF")"

	if [ -z "$private_key" ]; then
		msg_err "Failed to extract private_key from config.json."
		msg_warn "config.json keys (values redacted):"
		# 只打印 key 名,不泄露 secrets
		if command -v jq >/dev/null 2>&1; then
			jq -r 'keys[]' "$USQUE_CONF" >&2 2>/dev/null
		else
			grep -oE '"[^"]+"' "$USQUE_CONF" 2>/dev/null | head -10 >&2
		fi
		return 1
	fi

	# 保存到 UCI
	uci -q set warp.config.private_key="$private_key"
	[ -n "$address_v4" ] && uci -q set warp.config.address_v4="$address_v4"
	[ -n "$address_v6" ] && uci -q set warp.config.address_v6="$address_v6"
	[ -n "$license_key" ] && uci -q set warp.config.license_key="$license_key"
	uci commit warp

	msg_ok "WARP account registered successfully."
	[ -n "$address_v4" ] && printf '  IPv4: %s\n' "$address_v4"
	[ -n "$address_v6" ] && printf '  IPv6: %s\n' "$address_v6"
	printf '  Config: %s\n' "$USQUE_CONF"

	return 0
}

# ── 设置 WARP+ 许可证密钥 ────────────────────────────────────────────────
apply_license() {
	need_usque || return 1

	local USQUE_PATH
	USQUE_PATH="$(find_usque)"

	local LICENSE_KEY="${1:-$(uci -q get warp.config.license_key)}"
	if [ -z "$LICENSE_KEY" ]; then
		msg_err "license_key is empty. Usage: warp-manager license <key>"
		return 1
	fi

	if [ ! -f "$USQUE_CONF" ]; then
		msg_err "config.json not found. Run 'warp-manager register' first."
		return 1
	fi

	msg_ok "Setting WARP+ license key..."
	if "$USQUE_PATH" account set "$LICENSE_KEY" -c "$USQUE_CONF"; then
		uci -q set warp.config.license_key="$LICENSE_KEY"
		uci commit warp
		msg_ok "License key applied and saved."
		return 0
	else
		msg_err "Failed to set license key."
		return 1
	fi
}

# ── 获取服务运行状态 ───────────────────────────────────────────────────
get_status() {
	local USQUE_PATH
	if USQUE_PATH="$(find_usque 2>/dev/null)"; then
		printf 'Usque binary: %s\n' "$USQUE_PATH"
		local ver
		ver="$("$USQUE_PATH" version 2>/dev/null | head -n1)"
		[ -n "$ver" ] && printf 'Version: %s\n' "$ver"
	else
		printf 'Usque binary: not installed\n'
	fi
	printf '\n'

	# 服务运行状态
	if pgrep -f "usque.*config.json" >/dev/null 2>&1; then
		printf 'Service: \033[32mrunning\033[0m\n'
	else
		printf 'Service: \033[31mstopped\033[0m\n'
	fi

	# 账号注册状态
	if [ -f "$USQUE_CONF" ]; then
		printf 'Account: \033[32mregistered\033[0m\n'

		local addr_v4 addr_v6 private_key
		addr_v4="$(uci -q get warp.config.address_v4)"
		addr_v6="$(uci -q get warp.config.address_v6)"
		private_key="$(uci -q get warp.config.private_key)"
		[ -n "$private_key" ] && printf '  Private key: %s...%s\n' \
			"$(echo "$private_key" | head -c 8)" "$(echo "$private_key" | tail -c 5)"
		[ -n "$addr_v4" ] && printf '  IPv4: %s\n' "$addr_v4"
		[ -n "$addr_v6" ] && printf '  IPv6: %s\n' "$addr_v6"
	else
		printf 'Account: \033[31mnot registered\033[0m\n'
	fi
	printf '\n'

	# 端口监听状态
	local mode socks_port http_port
	mode="$(uci -q get warp.config.mode || echo 'socks')"
	socks_port="$(uci -q get warp.config.socks_port || echo '1080')"
	http_port="$(uci -q get warp.config.http_port || echo '8118')"

	case "$mode" in
		socks)
			if netstat -tln 2>/dev/null | grep -q ":${socks_port} "; then
				printf 'SOCKS5 Proxy: \033[32mlistening on port %s\033[0m\n' "$socks_port"
			else
				printf 'SOCKS5 Proxy: \033[31mnot listening (port %s)\033[0m\n' "$socks_port"
			fi
			;;
		http-proxy)
			if netstat -tln 2>/dev/null | grep -q ":${http_port} "; then
				printf 'HTTP Proxy: \033[32mlistening on port %s\033[0m\n' "$http_port"
			else
				printf 'HTTP Proxy: \033[31mnot listening (port %s)\033[0m\n' "$http_port"
			fi
			;;
		nativetun)
			# 检查 TUN 设备
			if ip link show warp-tun >/dev/null 2>&1 || ip link show tun0 >/dev/null 2>&1; then
				printf 'TUN Device: \033[32mactive\033[0m\n'
			else
				printf 'TUN Device: \033[31mnot active\033[0m\n'
			fi
			;;
	esac
}

# ── 测试网络连接 ───────────────────────────────────────────────────────
# 通过本地 SOCKS5/HTTP 代理请求 Cloudflare trace 接口
test_connection() {
	local mode socks_port http_port proxy_url

	mode="$(uci -q get warp.config.mode || echo 'socks')"
	socks_port="$(uci -q get warp.config.socks_port || echo '1080')"
	http_port="$(uci -q get warp.config.http_port || echo '8118')"

	case "$mode" in
		socks)
			proxy_url="socks5h://127.0.0.1:$socks_port"
			if ! netstat -tln 2>/dev/null | grep -q ":${socks_port} "; then
				msg_err "SOCKS5 proxy is not running on port $socks_port."
				return 1
			fi
			;;
		http-proxy)
			proxy_url="http://127.0.0.1:$http_port"
			if ! netstat -tln 2>/dev/null | grep -q ":${http_port} "; then
				msg_err "HTTP proxy is not running on port $http_port."
				return 1
			fi
			;;
		nativetun)
			# nativetun 模式直接测试，不走代理
			proxy_url=""
			;;
		*)
			msg_err "Unknown mode: $mode"
			return 1
			;;
	esac

	msg_ok "Testing WARP connection..."

	local test_output
	if [ -n "$proxy_url" ]; then
		test_output="$(curl -ks -x "$proxy_url" --connect-timeout 10 --max-time 15 \
			https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null)"
	else
		test_output="$(curl -ks --connect-timeout 10 --max-time 15 \
			https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null)"
	fi

	if [ -z "$test_output" ]; then
		msg_err "Failed to connect to Cloudflare trace service."
		return 1
	fi

	local warp_status ip_address location colo
	warp_status="$(echo "$test_output" | grep -i '^warp=' | cut -d= -f2 | tr -d '\r')"
	ip_address="$(echo "$test_output" | grep -i '^ip=' | cut -d= -f2 | tr -d '\r')"
	location="$(echo "$test_output" | grep -i '^loc=' | cut -d= -f2 | tr -d '\r')"
	colo="$(echo "$test_output" | grep -i '^colo=' | cut -d= -f2 | tr -d '\r')"

	printf '\n--- Test Results ---\n'
	if [ "$warp_status" = "on" ] || [ "$warp_status" = "plus" ]; then
		printf 'WARP Status: \033[32m%s\033[0m\n' "$warp_status"
	else
		printf 'WARP Status: \033[31m%s\033[0m\n' "${warp_status:-unknown}"
	fi
	printf 'Exit IP:     %s\n' "${ip_address:-unknown}"
	printf 'Location:    %s\n' "${location:-unknown}"
	printf 'Datacenter:  %s\n' "${colo:-unknown}"
	printf '--------------------\n'

	return 0
}

# ── 重置并清除配置 ─────────────────────────────────────────────────────
reset_account() {
	# 交互式确认（仅当 stdin 是终端时）
	if [ -t 0 ]; then
		msg_warn "This will delete all WARP account data. Continue? [y/N] "
		local choice
		read -r choice
		case "$choice" in
			y|Y|yes|YES) ;;
			*)
				msg_warn "Reset cancelled."
				return 0
				;;
		esac
	fi

	msg_ok "Resetting WARP account data..."
	rm -f "$USQUE_CONF"

	uci -q delete warp.config.private_key
	uci -q delete warp.config.address_v4
	uci -q delete warp.config.address_v6
	uci -q delete warp.config.license_key
	uci -q set warp.config.enabled='0'
	uci commit warp

	# 停止服务
	/etc/init.d/warp stop >/dev/null 2>&1 || true

	msg_ok "Account data has been cleared."
	return 0
}

# ── 导出 usque 配置文件 ────────────────────────────────────────────────
export_config() {
	if [ -f "$USQUE_CONF" ]; then
		cat "$USQUE_CONF"
		return 0
	else
		msg_err "No config.json found. Run 'warp-manager register' first."
		return 1
	fi
}

# ── 设置 UCI enabled 标志 ──────────────────────────────────────────────
set_enabled() {
	local value="$1"
	uci -q get warp.config >/dev/null 2>&1 || uci set warp.config='warp'
	uci set warp.config.enabled="$value"
	uci commit warp
}

# ── 架构检测 ───────────────────────────────────────────────────────────
detect_arch() {
	local arch_str=""
	local machine
	machine="$(uname -m 2>/dev/null)"

	# 优先使用 UCI 中手动指定的架构
	arch_str="$(uci -q get warp.config.usque_arch 2>/dev/null)"
	if [ -n "$arch_str" ]; then
		echo "$arch_str"
		return 0
	fi

	case "$machine" in
		aarch64|arm64)
			arch_str="linux_arm64"
			;;
		x86_64|amd64)
			arch_str="linux_amd64"
			;;
		armv7l|armv7)
			arch_str="linux_armv7"
			;;
		armv6l|armv6)
			arch_str="linux_armv6"
			;;
		armv5tel|armv5)
			arch_str="linux_armv5"
			;;
		mips)
			arch_str="linux_mips"
			;;
		mipsel|mipsle)
			arch_str="linux_mipsle"
			;;
		mips64)
			arch_str="linux_mips64"
			;;
		mips64el|mips64le)
			arch_str="linux_mips64le"
			;;
		*)
			# 回退: 尝试 opkg print-architecture
			if command -v opkg >/dev/null 2>&1; then
				local opkg_arch
				opkg_arch="$(opkg print-architecture 2>/dev/null | head -n1 | awk '{print $2}')"
				case "$opkg_arch" in
					aarch64|cortex-a53*|cortex-a72*) arch_str="linux_arm64" ;;
					arm_cortex-a*) arch_str="linux_armv7" ;;
					mipsel*) arch_str="linux_mipsle" ;;
					mips*) arch_str="linux_mips" ;;
					x86_64) arch_str="linux_amd64" ;;
				esac
			fi
			;;
	esac

	if [ -z "$arch_str" ]; then
		return 1
	fi

	echo "$arch_str"
	return 0
}

# ── 安装 usque 二进制 ──────────────────────────────────────────────────
install_usque() {
	local arch
	if ! arch="$(detect_arch)"; then
		msg_err "Failed to detect architecture (uname -m: $(uname -m))."
		msg_warn "Please set it manually: uci set warp.config.usque_arch='linux_arm64'; uci commit warp"
		return 1
	fi

	msg_ok "Detected architecture: $arch"

	# GitHub release 文件名格式: usque_<version>_<arch>.zip
	local url="${USQUE_BASE_URL}/usque_${USQUE_VER_NUM}_${arch}.zip"
	local tmp_zip tmp_dir
	tmp_zip="$(mktemp /tmp/usque_XXXXXXXX.zip)"
	tmp_dir="$(mktemp -d /tmp/usque_extract_XXXXXX)"

	msg_ok "Downloading usque from $url ..."
	if command -v curl >/dev/null 2>&1; then
		curl -fL --connect-timeout 15 --retry 3 "$url" -o "$tmp_zip"
	elif command -v wget >/dev/null 2>&1; then
		wget -O "$tmp_zip" "$url"
	else
		msg_err "curl or wget is required to download usque."
		return 1
	fi

	if [ ! -s "$tmp_zip" ]; then
		msg_err "Downloaded file is empty. Check network connectivity."
		rm -f "$tmp_zip"
		return 1
	fi

	# 解压 zip
	mkdir -p "$tmp_dir"
	if command -v unzip >/dev/null 2>&1; then
		unzip -o "$tmp_zip" -d "$tmp_dir" >/dev/null 2>&1
	elif command -v busybox >/dev/null 2>&1; then
		busybox unzip -o "$tmp_zip" -d "$tmp_dir" >/dev/null 2>&1
	else
		msg_err "unzip is required to extract usque. Install: opkg install unzip"
		rm -f "$tmp_zip"
		return 1
	fi

	# 查找解压出的 usque 二进制 (可能是 usque, usque_<arch>, 或在子目录里)
	local bin_found
	bin_found="$(find "$tmp_dir" -name 'usque' -type f 2>/dev/null | head -1)"
	if [ -z "$bin_found" ]; then
		# 也可能叫 usque_<arch> 或其他名字
		bin_found="$(find "$tmp_dir" -type f \( -perm -u+x -o -perm -g+x -o -perm -o+x \) 2>/dev/null | head -1)"
		# 回退: 如果 find 不支持 -perm 语法,直接找名为 usque* 的文件
		if [ -z "$bin_found" ]; then
			bin_found="$(find "$tmp_dir" -type f -name 'usque*' 2>/dev/null | head -1)"
		fi
	fi

	if [ -z "$bin_found" ]; then
		msg_err "Could not find usque binary in extracted files."
		msg_warn "Extracted files:"
		find "$tmp_dir" -type f 2>/dev/null | head -10
		rm -rf "$tmp_dir" "$tmp_zip"
		return 1
	fi

	# 验证是否为可执行二进制
	if ! "$bin_found" version >/dev/null 2>&1; then
		msg_err "Downloaded binary is not executable or is corrupted."
		msg_warn "First bytes:"
		file "$bin_found" 2>/dev/null || head -c 16 "$bin_found" | xxd 2>/dev/null || true
		rm -rf "$tmp_dir" "$tmp_zip"
		return 1
	fi

	# 安装到 /usr/bin/usque
	mv "$bin_found" "$USQUE_BIN"
	chmod 755 "$USQUE_BIN"

	rm -rf "$tmp_dir" "$tmp_zip"

	msg_ok "usque installed to $USQUE_BIN"
	"$USQUE_BIN" version 2>/dev/null && printf '\n'

	return 0
}

# ── 主入口 ─────────────────────────────────────────────────────────────
case "${1:-}" in
	register)
		register_account
		;;
	license)
		apply_license "${2:-}"
		;;
	status)
		get_status
		;;
	test)
		test_connection
		;;
	start)
		set_enabled 1
		/etc/init.d/warp start
		;;
	stop)
		set_enabled 0
		/etc/init.d/warp stop
		;;
	restart)
		set_enabled 1
		/etc/init.d/warp restart
		;;
	reset)
		reset_account
		;;
	export)
		export_config
		;;
	install-usque)
		install_usque
		;;
	*)
		cat <<EOF
Usage: $0 {register|license <key>|start|stop|restart|status|test|reset|export|install-usque}

Commands:
  register        Register a new WARP account via usque
  license <key>   Set WARP+ license key
  start           Start WARP service
  stop            Stop WARP service
  restart         Restart WARP service
  status          Show service and account status
  test            Test WARP connectivity via Cloudflare trace
  reset           Delete all WARP account data (interactive)
  export          Print usque config.json
  install-usque   Download and install usque binary (auto-detect arch)
EOF
		exit 1
		;;
esac